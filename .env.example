# Copy to .env and edit:  cp .env.example .env
# Generate secrets with:  openssl rand -hex 32

# --- production (docker-compose.prod.yml) ---
DOMAIN=                      # e.g. school.example.com; set APP_ENV=prod, COOKIE_SECURE=true, CORS_ORIGINS=https://$DOMAIN

# --- database ---
POSTGRES_USER=sms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sms

# --- api ---
# demo = seeds one user per role and shows them on the login page. Use "prod" for real deployments.
APP_ENV=demo
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
COOKIE_SECURE=false          # must be true behind HTTPS (required when APP_ENV=prod)
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- seeding (docker entrypoint runs it when RUN_SEED=true; it is idempotent) ---
RUN_SEED=true
SEED_SAMPLE_DATA=false             # true = also create sample classes, students and teachers (always on when APP_ENV=demo)
SEED_DEMO_PASSWORD=Demo@12345       # demo accounts only (APP_ENV=demo)
FIRST_ADMIN_USERNAME=admin          # used when APP_ENV is not demo
FIRST_ADMIN_PASSWORD=               # 8+ chars, letter + digit; leave empty to skip creating an admin
